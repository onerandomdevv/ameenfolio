# Application (use http://localhost:3000 for both values locally).
# In a deployment these must be the exact origin serving it, or canonical URLs,
# the sitemap, and OAuth redirects point at the wrong host.
NEXT_PUBLIC_APP_URL=https://your-production-domain.example
CANONICAL_SITE_URL=https://your-production-domain.example

# Neon Postgres (pooled runtime URL, direct URL for migration jobs)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_MIGRATION_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
# Neon CLI names the direct URL DATABASE_URL_UNPOOLED; Drizzle accepts either name.
DATABASE_URL_UNPOOLED=

# Neon Auth + GitHub OAuth (OAuth credentials are configured in Neon, not here)
NEON_AUTH_BASE_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth
# Generate a separate production value with at least 32 random characters.
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
ADMIN_GITHUB_USER_ID=231661599

# Private Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
# Use ameenfolio-media-dev locally and ameenfolio-media-prod in production.
R2_BUCKET_NAME=ameenfolio-media-prod
# Optional future custom media hostname; leave blank while R2 remains private.
R2_PUBLIC_BASE_URL=
# Browser uploads PUT straight to R2, so allowed origins are bucket CORS
# configuration, not an environment variable. See config/r2-cors.json.

# GitHub stats strip (optional). The strip always renders; without these the
# GitHub-backed cells show a dash and no refresh is attempted.
# A classic PAT with no scopes is enough for public contribution data; add
# read:user if you want private contributions counted too.
GITHUB_STATS_USERNAME=onerandomdevv
GITHUB_STATS_TOKEN=

# WakaTime live coding presence (optional, server-only).
# Copy the secret key from https://wakatime.com/api-key. It is used only by the
# server to publish coding/staleness state, the account date, formatted and raw
# daily/weekly totals, daily average, top language, seven-day activity, and
# heartbeat/check timestamps. Never expose it through NEXT_PUBLIC_* variables.
WAKATIME_API_KEY=
